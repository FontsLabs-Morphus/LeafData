import csv
import os
import tempfile

from airflow.models import BaseOperator
from airflow.providers.microsoft.azure.hooks.wasb import WasbHook
from airflow.utils.context import Context
from azure.storage.blob import BlobServiceClient
from custom_logger.execution_logger import log_execution
from custom_logger.metrics_logger import (
    MetricsContext,
    log_source_metrics,
    csv_profile,
    log_destination_metrics
)
from custom_operators.metaclass import Source, Destination
from exceptions.custom_exception import MorphusAirflowException

from constants import NT_TRANSFORMATIONS


class PullAzureBlobOperator(BaseOperator, Source):
    """
    Streaming pull from Azure Blob Storage.
    Reads CSV row-by-row, applies transformation row-by-row,
    and writes incrementally to a CSV file for downstream tasks.
    """

    def __init__(
            self,
            azure_conn_id: str,
            blob_name: str,
            tx_list,
            container_name: str,
            header_less_file: str,
            headers: list[str],
            ext: str = "csv",
            delimiter: str = ",",
            *args,
            **kwargs,
    ):
        super().__init__(*args, **kwargs)
        self.task_id = kwargs.get("task_id")
        self.azure_conn_id = azure_conn_id.strip()
        self.container_name = container_name.strip()
        self.blob_name = blob_name.strip()
        self.header_less_file = header_less_file
        self.headers = headers
        self.delimiter = delimiter
        self.ext = ext
        self.tx_list = [NT_TRANSFORMATIONS(*tx) for tx in tx_list]

    def _source_descriptor(self) -> dict:
        return {
            "source_type": "AZUREBLOB",  # or MYSQL / S3 / SALESFORCE
            "source_location": self.container_name,
            "source_object": self.blob_name,
            "header_less_file": str(self.header_less_file).lower() == "yes",
            "delimiter": self.delimiter,
        }

    # ------------------------------------------------------------------
    # Connection
    # ------------------------------------------------------------------
    def _setup_connection(self) -> WasbHook:
        self.log.info("Connecting to Azure Blob Storage...")
        try:
            hook = WasbHook(wasb_conn_id=self.azure_conn_id)
            conn = hook.get_conn()
            self.log.info("Azure Blob connection successful.")
            return hook, conn

        except MorphusAirflowException:
            raise

        except Exception as e:
            self.log.error("Failed to connect to Azure Blob Storage")
            raise MorphusAirflowException(
                message="Failed to connect to Azure Blob Storage",
                task_id=self.task_id,
                error_source="PullAzureBlobOperator._setup_connection",
                original_exception=e
            ) from e

    # ------------------------------------------------------------------
    # STREAMING FETCH
    # ------------------------------------------------------------------

    def _fetch_data(self, hook):
        """
        TRUE streaming CSV reader for Azure Blob.
        Constant memory, 100GB safe.
        """
        container = self.container_name
        blob = self.blob_name

        self.log.info("Streaming Azure Blob using chunked download")

        try:
            service_client: BlobServiceClient = hook.get_conn()
            container_client = service_client.get_container_client(container)
            blob_client = container_client.get_blob_client(blob)

            downloader = blob_client.download_blob()
            buffer = ""

            for chunk in downloader.chunks():
                buffer += chunk.decode("utf-8")

                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    row = next(csv.reader([line], delimiter=self.delimiter))
                    cleaned = [c.strip() for c in row]
                    if any(cleaned):
                        yield cleaned

            # Handle last partial line
            if buffer.strip():
                row = next(csv.reader([buffer], delimiter=self.delimiter))
                yield [c.strip() for c in row]

        except Exception as e:
            raise MorphusAirflowException(
                message="Failed while streaming Azure Blob data",
                task_id=self.task_id,
                error_source="PullAzureBlobOperator._fetch_data",
                original_exception=e
            ) from e

    # ------------------------------------------------------------------
    # EXECUTION
    # ------------------------------------------------------------------
    def execute(self, context: Context) -> None:
        """
        Execution flow:
        Azure Blob (stream) →
        transform (stream) →
        CSV write (stream) →
        XCom CSV path
        """
        dag_id = context["dag"].dag_id
        run_id = context["run_id"]
        self._metrics = MetricsContext(
            dag_id=dag_id,
            run_id=run_id,
            task_id=self.task_id
        )
        self.log.info(
            "[METRICS][INIT] metrics_context_created=%s | dag_id=%s | run_id=%s | task_id=%s",
            isinstance(self._metrics, MetricsContext),
            self._metrics.dag_id,
            self._metrics.run_id,
            self._metrics.task_id,
        )

        try:
            hook, conn = self._setup_connection()

            raw_iter = self._fetch_data(hook)
            self.log.info(
                "[METRICS][BEFORE_TRANSFORM] rows_read=%s | rows_after_transform=%s | rows_written=%s",
                self._metrics.rows_read,
                self._metrics.rows_after_transform,
                self._metrics.rows_written,
            )

            transformed_iter = self._transform_data_stream(
                raw_iter,
                self.header_less_file,
                self.headers,
            )

            self._save_data_stream(
                context=context,
                row_iter=transformed_iter,
                ext=self.ext,
                delimiter=self.delimiter,
            )

            self.log.info(
                "[METRICS][AFTER_SAVE] "
                "rows_read=%s | rows_after_transform=%s | rows_written=%s | "
                "cols_read=%s | cols_after_transform=%s | "
                "file_path=%s | transform_count=%s | has_expression=%s",
                self._metrics.rows_read,
                self._metrics.rows_after_transform,
                self._metrics.rows_written,
                self._metrics.cols_read,
                self._metrics.cols_after_transform,
                self._metrics.file_path,
                self._metrics.transform_count,
                self._metrics.has_expression,
            )

            self._metrics.finish()
            d = self._source_descriptor()

            self.log.info(
                "[METRICS][PRE_DB_INSERT] "
                "status=SUCCESS | rows_read=%s | rows_after_transform=%s | rows_written=%s | "
                "cols_read=%s | cols_after_transform=%s | file_path=%s",
                self._metrics.rows_read,
                self._metrics.rows_after_transform,
                self._metrics.rows_written,
                self._metrics.cols_read,
                self._metrics.cols_after_transform,
                self._metrics.file_path,
            )

            log_source_metrics(
                dag_id=self._metrics.dag_id,
                run_id=self._metrics.run_id,
                task_id=self._metrics.task_id,

                source_type=d["source_type"],
                source_location=d["source_location"],
                source_object=d["source_object"],

                header_less_file=d["header_less_file"],
                delimiter=d["delimiter"],

                cols_read=self._metrics.cols_read,
                rows_read=self._metrics.rows_read,

                cols_after_transform=self._metrics.cols_after_transform,
                rows_after_transform=self._metrics.rows_after_transform,

                rows_written=self._metrics.rows_written,
                file_path=self._metrics.file_path,

                transform_count=self._metrics.transform_count,
                has_expression=self._metrics.has_expression,

                status="SUCCESS",

                start_time=self._metrics.start_time,
                end_time=self._metrics.end_time,
                duration_ms=self._metrics.duration_ms,
            )

        except MorphusAirflowException as e:
            log_execution(
                dag_id=dag_id,
                task_id=self.task_id,
                run_id=run_id,
                status="FAILED",
                error_source=e.error_source,
                error_message=str(e),
                root_cause=repr(e.original_exception)
            )

            self._metrics.finish()
            d = self._source_descriptor()

            log_source_metrics(
                dag_id=self._metrics.dag_id,
                run_id=self._metrics.run_id,
                task_id=self._metrics.task_id,

                source_type=d["source_type"],
                source_location=d["source_location"],
                source_object=d["source_object"],

                header_less_file=d["header_less_file"],
                delimiter=d["delimiter"],

                cols_read=self._metrics.cols_read,
                rows_read=self._metrics.rows_read,

                cols_after_transform=self._metrics.cols_after_transform,
                rows_after_transform=self._metrics.rows_after_transform,

                rows_written=self._metrics.rows_written,
                file_path=self._metrics.file_path,

                transform_count=self._metrics.transform_count,
                has_expression=self._metrics.has_expression,

                status="FAILED",

                start_time=self._metrics.start_time,
                end_time=self._metrics.end_time,
                duration_ms=self._metrics.duration_ms,

                error_source=e.error_source,
                error_message=str(e),
            )

            raise

        except Exception as e:
            log_execution(
                dag_id=dag_id,
                task_id=self.task_id,
                run_id=run_id,
                status="FAILED",
                error_source=f"{self.__class__.__name__}.execute",
                error_message=str(e),
                root_cause=repr(e)
            )

            self._metrics.finish()
            d = self._source_descriptor()

            log_source_metrics(
                dag_id=self._metrics.dag_id,
                run_id=self._metrics.run_id,
                task_id=self._metrics.task_id,

                source_type=d["source_type"],
                source_location=d["source_location"],
                source_object=d["source_object"],

                header_less_file=d["header_less_file"],
                delimiter=d["delimiter"],

                cols_read=self._metrics.cols_read,
                rows_read=self._metrics.rows_read,

                cols_after_transform=self._metrics.cols_after_transform,
                rows_after_transform=self._metrics.rows_after_transform,

                rows_written=self._metrics.rows_written,
                file_path=self._metrics.file_path,

                transform_count=self._metrics.transform_count,
                has_expression=self._metrics.has_expression,

                status="FAILED",

                start_time=self._metrics.start_time,
                end_time=self._metrics.end_time,
                duration_ms=self._metrics.duration_ms,

                error_source=str(e),
                error_message=str(e),
            )

            raise
        finally:
            try:
                if conn:
                    conn.close()
                    self.log.info(" Connection closed successfully.")
            except Exception as cleanup_error:
                self.log.warning(
                    f" Failed to close connection: {cleanup_error}"
                )


class PushAzureBlobOperator(BaseOperator, Destination):
    """
    Push CSV (from XCom path) into Azure Blob Storage.
    Supports 'overwrite' and 'append' modes.
    """

    def __init__(
            self,
            azure_conn_id: str,
            blob_name: str,
            data_write_mode: str,
            container_name: str = "filetransfer",
            *args,
            **kwargs,
    ):
        super().__init__(*args, **kwargs)
        self.task_id = kwargs.get("task_id")
        self.azure_conn_id = azure_conn_id.strip()
        self.container_name = container_name.strip()
        self.blob_name = blob_name.strip()
        self.data_write_mode = data_write_mode.lower().strip()

    def _destination_descriptor(self) -> dict:
        return {
            "destination_type": "AZUREBLOB",
            "destination_location": self.container_name,
            "destination_object": self.blob_name,
            "write_mode": self.data_write_mode,
        }

    # ------------------------------------------------------------------
    def _setup_connection(self) -> WasbHook:
        self.log.info("Connecting to Azure Blob Storage...")
        try:
            hook = WasbHook(wasb_conn_id=self.azure_conn_id)
            conn = hook.get_conn()
            self.log.info("Azure Blob connection validated successfully.")
            return hook, conn

        except MorphusAirflowException:
            raise

        except Exception as e:
            self.log.error("Failed to connect to Azure Blob Storage")
            raise MorphusAirflowException(
                message="Failed to connect to Azure Blob Storage",
                task_id=self.task_id,
                error_source="PushAzureBlobOperator._setup_connection",
                original_exception=e
            ) from e

    # ------------------------------------------------------------------
    def _blob_exists(self, hook: WasbHook) -> bool:
        try:
            return hook.check_for_blob(
                self.container_name.strip(),
                self.blob_name.strip()
            )
        except Exception as e:
            raise MorphusAirflowException(
                message="Failed while checking blob existence",
                task_id=self.task_id,
                error_source="PushAzureBlobOperator._blob_exists",
                original_exception=e
            ) from e

    # ------------------------------------------------------------------
    def _clean_file(self, file_path: str, delimiter=",") -> str:
        try:
            cleaned_rows = []
            with open(file_path, "r", encoding="utf-8") as f:
                reader = csv.reader(f, delimiter=delimiter)
                for row in reader:
                    cleaned = [cell.strip() for cell in row if cell.strip() != ""]
                    if cleaned:
                        cleaned_rows.append(cleaned)

            with tempfile.NamedTemporaryFile(
                    delete=False, suffix=".csv", mode="w", encoding="utf-8"
            ) as tmp:
                writer = csv.writer(tmp, delimiter=delimiter)
                writer.writerows(cleaned_rows)
                return tmp.name

        except Exception as e:
            raise MorphusAirflowException(
                message="Failed while cleaning CSV file before upload",
                task_id=self.task_id,
                error_source="PushAzureBlobOperator._clean_file",
                original_exception=e
            ) from e

    # ------------------------------------------------------------------
    def _upload_data(self, hook: WasbHook, data_filename: str) -> None:
        container = self.container_name.strip()
        blob = self.blob_name.strip()

        self.log.info(f"Uploading data to Azure Blob: {container}/{blob}")
        self.log.info(f"Data write mode: {self.data_write_mode}")

        try:
            cleaned_file = self._clean_file(data_filename, delimiter=",")

            if self.data_write_mode == "overwrite":
                hook.load_file(
                    cleaned_file,
                    container_name=container,
                    blob_name=blob,
                    overwrite=True
                )

            elif self.data_write_mode == "append":
                if self._blob_exists(hook):
                    existing_data = hook.read_file(container, blob).strip()
                    with open(cleaned_file, "r", encoding="utf-8") as nf:
                        new_data = nf.read().strip()

                    existing_lines = existing_data.splitlines()
                    new_lines = new_data.splitlines()

                    if new_lines and existing_lines and new_lines[0] == existing_lines[0]:
                        new_lines = new_lines[1:]

                    combined = "\n".join(existing_lines + new_lines)

                    with tempfile.NamedTemporaryFile(
                            delete=False, suffix=".csv", mode="w", encoding="utf-8"
                    ) as tmp:
                        tmp.write(combined)
                        tmp_path = tmp.name

                    hook.load_file(
                        tmp_path,
                        container_name=container,
                        blob_name=blob,
                        overwrite=True
                    )
                    os.remove(tmp_path)
                else:
                    hook.load_file(
                        cleaned_file,
                        container_name=container,
                        blob_name=blob,
                        overwrite=True
                    )

            else:
                raise MorphusAirflowException(
                    message=f"Invalid data_write_mode '{self.data_write_mode}'",
                    task_id=self.task_id,
                    error_source="PushAzureBlobOperator._upload_data"
                )

            os.remove(cleaned_file)
            self.log.info("Data uploaded successfully to Azure Blob Storage.")

        except MorphusAirflowException:
            raise

        except Exception as e:
            self.log.error("Error occurred while uploading data to Azure Blob Storage")
            raise MorphusAirflowException(
                message="Failed while uploading data to Azure Blob Storage",
                task_id=self.task_id,
                error_source="PushAzureBlobOperator._upload_data",
                original_exception=e
            ) from e

    # ------------------------------------------------------------------
    def execute(self, context: Context) -> None:
        dag_id = context["dag"].dag_id
        run_id = context["run_id"]

        self._metrics = MetricsContext(
            dag_id=dag_id,
            run_id=run_id,
            task_id=self.task_id
        )

        try:
            hook, conn = self._setup_connection()
            data_filename = self._fetch_data(context)
            rows, cols = csv_profile(data_filename)
            self._metrics.rows_loaded = rows
            self._metrics.cols_loaded = cols
            self._metrics.source_file_path = data_filename

            self._upload_data(hook, data_filename)

            self._metrics.finish()
            d = self._destination_descriptor()

            log_destination_metrics(
                dag_id=self._metrics.dag_id,
                run_id=self._metrics.run_id,
                task_id=self._metrics.task_id,

                destination_type=d["destination_type"],
                destination_location=d["destination_location"],
                destination_object=d["destination_object"],

                write_mode=d["write_mode"],

                cols_loaded=self._metrics.cols_loaded,
                rows_loaded=self._metrics.rows_loaded,

                source_file_path=self._metrics.source_file_path,

                status="SUCCESS",

                start_time=self._metrics.start_time,
                end_time=self._metrics.end_time,
                duration_ms=self._metrics.duration_ms,
            )
            self._cleanup_temp_file(data_filename)



        except MorphusAirflowException as e:
            log_execution(
                dag_id=dag_id,
                task_id=self.task_id,
                run_id=run_id,
                status="FAILED",
                error_source=e.error_source,
                error_message=str(e),
                root_cause=repr(e.original_exception)
            )
            raise

        except Exception as e:
            log_execution(
                dag_id=dag_id,
                task_id=self.task_id,
                run_id=run_id,
                status="FAILED",
                error_source="PushAzureBlobOperator.execute",
                error_message=str(e),
                root_cause=repr(e)
            )
            raise
        finally:
            try:
                if conn:
                    conn.close()
                    self.log.info(" Connection closed successfully.")
            except Exception as cleanup_error:
                self.log.warning(
                    f" Failed to close connection: {cleanup_error}"
                )

